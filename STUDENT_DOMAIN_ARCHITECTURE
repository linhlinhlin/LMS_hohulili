## 4. Value Objects

### 4.1 Course Code

```java
/**
 * Value Object: Course Code
 * Ensures course codes follow maritime standards
 */
@Embeddable
@EqualsAndHashCode
public class CourseCode {
    @Column(name = "code", length = 20)
    private final String value;
    
    private CourseCode(String value) {
        validate(value);
        this.value = value.toUpperCase();
    }
    
    public static CourseCode of(String code) {
        return new CourseCode(code);
    }
    
    private void validate(String code) {
        if (code == null || code.trim().isEmpty()) {
            throw new IllegalArgumentException("Course code cannot be empty");
        }
        if (code.length() > 20) {
            throw new IllegalArgumentException("Course code cannot exceed 20 characters");
        }
        if (!code.matches("^[A-Z0-9-]+$")) {
            throw new IllegalArgumentException("Course code must contain only uppercase letters, numbers, and hyphens");
        }
    }
    
    @Override
    public String toString() {
        return value;
    }
}
```

### 4.2 Progress Percentage

```java
/**
 * Value Object: Progress Percentage
 * Ensures progress values are within valid range
 */
@Embeddable
@EqualsAndHashCode
public class ProgressPercentage {
    @Column(name = "progress_percentage")
    private final BigDecimal value;
    
    private ProgressPercentage(BigDecimal value) {
        validate(value);
        this.value = value.setScale(2, RoundingMode.HALF_UP);
    }
    
    public static ProgressPercentage of(BigDecimal value) {
        return new ProgressPercentage(value);
    }
    
    public static ProgressPercentage zero() {
        return new ProgressPercentage(BigDecimal.ZERO);
    }
    
    public static ProgressPercentage hundred() {
        return new ProgressPercentage(BigDecimal.valueOf(100));
    }
    
    private void validate(BigDecimal value) {
        if (value == null) {
            throw new IllegalArgumentException("Progress percentage cannot be null");
        }
        if (value.compareTo(BigDecimal.ZERO) < 0 || value.compareTo(BigDecimal.valueOf(100)) > 0) {
            throw new IllegalArgumentException("Progress percentage must be between 0 and 100");
        }
    }
    
    public boolean isCompleted() {
        return this.value.compareTo(BigDecimal.valueOf(100)) >= 0;
    }
    
    public boolean isInProgress() {
        return this.value.compareTo(BigDecimal.ZERO) > 0 && 
               this.value.compareTo(BigDecimal.valueOf(100)) < 0;
    }
    
    @Override
    public String toString() {
        return value.toString() + "%";
    }
}
```


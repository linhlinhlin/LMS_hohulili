## 5. Domain Services

### 5.1 Student Enrollment Service

```java
/**
 * Domain Service: Student Enrollment
 * Handles cross-aggregate business rules for enrollment
 */
@Service
@Transactional(readOnly = true)
public class StudentEnrollmentDomainService {
    
    /**
     * Enrolls a student in a course
     * Validates business rules across Student and Course aggregates
     */
    public Enrollment enrollStudent(Student student, Course course) {
        // Business Rules Validation
        validateEnrollmentPrerequisites(student, course);
        validateCapacityLimits(course);
        validateScheduleConflicts(student, course);
        
        // Create enrollment
        Enrollment enrollment = Enrollment.builder()
                .student(student)
                .course(course)
                .status(EnrollmentStatus.ACTIVE)
                .enrolledAt(Instant.now())
                .build();
        
        // Update aggregates
        student.addEnrollment(enrollment);
        course.addEnrollment(enrollment);
        
        return enrollment;
    }
    
    /**
     * Checks if student can enroll in course
     */
    public boolean canEnroll(Student student, Course course) {
        return !student.isEnrolledIn(course.getId()) &&
               course.hasCapacity() &&
               course.isAvailableForEnrollment() &&
               validatePrerequisites(student, course);
    }
    
    /**
     * Calculates enrollment deadline for course
     */
    public Instant calculateEnrollmentDeadline(Course course) {
        Instant courseStartDate = course.getStartDate();
        Duration enrollmentWindow = Duration.ofDays(30); // 30 days before course
        
        return courseStartDate.minus(enrollmentWindow);
    }
    
    private void validateEnrollmentPrerequisites(Student student, Course course) {
        // Check if student meets prerequisites
        List<Course> prerequisites = course.getPrerequisites();
        for (Course prerequisite : prerequisites) {
            if (!student.hasCompleted(prerequisite)) {
                throw new BusinessRuleViolation(
                    String.format("Student must complete prerequisite course: %s", prerequisite.getTitle())
                );
            }
        }
    }
    
    private void validateCapacityLimits(Course course) {
        if (!course.hasCapacity()) {
            throw new BusinessRuleViolation("Course has reached maximum capacity");
        }
    }
    
    private void validateScheduleConflicts(Student student, Course course) {
        // Check for schedule conflicts with other enrolled courses
        List<Enrollment> conflictingEnrollments = student.getEnrollments().stream()
                .filter(enrollment -> enrollment.getStatus() == EnrollmentStatus.ACTIVE)
                .filter(enrollment -> hasScheduleConflict(enrollment.getCourse(), course))
                .collect(Collectors.toList());
                
        if (!conflictingEnrollments.isEmpty()) {
            throw new BusinessRuleViolation("Schedule conflict detected with another enrolled course");
        }
    }
    
    private boolean hasScheduleConflict(Course course1, Course course2) {

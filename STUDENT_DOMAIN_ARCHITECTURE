## 7. Business Rules

### 7.1 Enrollment Business Rules

```java
/**
 * Business Rules: Enrollment
 * Defines all enrollment-related business constraints
 */
public class EnrollmentBusinessRules {
    
    /**
     * Rule: Student can only enroll in approved courses
     */
    public static void validateCourseStatus(Course course) {
        if (course.getStatus() != CourseStatus.APPROVED) {
            throw new BusinessRuleViolation("Can only enroll in approved courses");
        }
    }
    
    /**
     * Rule: Student must meet course prerequisites
     */
    public static void validatePrerequisites(Student student, Course course) {
        List<Course> prerequisites = course.getPrerequisites();
        for (Course prerequisite : prerequisites) {
            if (!student.hasCompleted(prerequisite)) {
                throw new BusinessRuleViolation(
                    String.format("Prerequisite course '%s' must be completed first", 
                                prerequisite.getTitle())
                );
            }
        }
    }
    
    /**
     * Rule: Course must have available capacity
     */
    public static void validateCapacity(Course course) {
        int currentEnrollment = course.getActiveEnrollmentCount();
        int maxCapacity = course.getMaxCapacity();
        
        if (currentEnrollment >= maxCapacity) {
            throw new BusinessRuleViolation("Course has reached maximum capacity");
        }
    }
    
    /**
     * Rule: Student cannot be enrolled in the same course twice
     */
    public static void validateDuplicateEnrollment(Student student, Course course) {
        if (student.isEnrolledIn(course.getId())) {
            throw new BusinessRuleViolation("Student is already enrolled in this course");
        }
    }
    
    /**
     * Rule: Enrollment deadline must not have passed
     */
    public static void validateEnrollmentDeadline(Course course) {
        Instant deadline = course.getEnrollmentDeadline();
        if (deadline != null && Instant.now().isAfter(deadline)) {
            throw new BusinessRuleViolation("Enrollment deadline has passed");
        }
    }
}

# =============================================================================
# Dedicated Video Worker Environment
# Copy to .env.video-worker on the worker VM.
# =============================================================================

SPRING_PROFILES_ACTIVE=prod

# Remote database for the main LMS deployment.
# Use a private IP / VPN / internal DNS path if possible.
# If the worker reaches PostgreSQL through a host-level forwarder such as socat,
# prefer sslmode=disable unless that private hop terminates PostgreSQL SSL itself.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_MAIN_DB_HOST:5432/lms?sslmode=disable
SPRING_DATASOURCE_USERNAME=lms
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

JWT_SECRET=CHANGE_ME_256_BIT_SECRET
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

APP_BASE_URL=https://holilihu.online
APP_CORS_ORIGINS=https://holilihu.online

CLOUDFLARE_R2_ENABLED=true
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=lms-cdn
CLOUDFLARE_R2_VIDEO_BUCKET=lms-storage
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.holilihu.online

VIDEO_INGEST_ENABLED=true
VIDEO_PLAYBACK_TOKEN_EXPIRY_SECONDS=14400
VIDEO_SEGMENT_PRESIGN_TTL_SECONDS=120
VIDEO_MANIFEST_CACHE_SECONDS=60
VIDEO_OBJECT_REDIRECT_CACHE_SECONDS=30
VIDEO_PACKAGE_UPLOAD_CONCURRENCY=6
VIDEO_ADAPTIVE_SEGMENT_DURATION_SECONDS=6
VIDEO_FFMPEG_PRESET=superfast

VIDEO_WORKER_CPU_LIMIT=3.0
VIDEO_WORKER_MEMORY_LIMIT=3072M
VIDEO_WORKER_MEMORY_RESERVATION=2048M

AI_SERVICE_URL=https://wiii.holilihu.online
AI_SERVICE_API_KEY=
WIII_WEBHOOK_URL=
WIII_WEBHOOK_SECRET=
WIII_WEBHOOK_ENABLED=false
WIII_SERVICE_TOKEN=
WIII_TOKEN_EXCHANGE_URL=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RESEND_API_KEY=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=

SEPAY_ENABLED=false
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_TEMPLATE_CODE=compact2

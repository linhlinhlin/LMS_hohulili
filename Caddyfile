# =============================================================================
# LMS Maritime - Caddy Reverse Proxy Configuration
# Auto-HTTPS via Let's Encrypt for holilihu.online
# =============================================================================

holilihu.online {
    # Backend API
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Health check only (other actuator endpoints not exposed)
    handle /actuator/health {
        reverse_proxy backend:8080
    }

    # File uploads (LocalStorageService)
    handle /uploads/* {
        reverse_proxy backend:8080
    }

    # Frontend (Angular SPA) — catch-all
    handle {
        reverse_proxy frontend:80
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://wiii.holilihu.online https://sandbox.vnpayment.vn https://pay.vnpay.vn https://qr.sepay.vn https://videodelivery.net wss:; media-src 'self' data: blob: https:; font-src 'self' data:; frame-src 'self' https: blob:; object-src 'none'; base-uri 'self';"
    }

    # Compression
    encode gzip zstd
}

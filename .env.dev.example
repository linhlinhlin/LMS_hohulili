# =============================================================================
# Maritime LMS - Development Environment Example
# Copy to .env for local Docker Compose development.
# Root compose is the single supported local runtime topology.
# =============================================================================

# === Database ===
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_DB=lms

# === JWT Security ===
# Dev-only Base64 key placeholder. Replace if your local setup needs a custom value.
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1zZWNyZXQta2V5LWZvci1sbXMtYXBwbGljYXRpb24tbWluaW11bS0yNTYtYml0cw==
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# === App URLs ===
APP_BASE_URL=http://localhost:4200
APP_CORS_ORIGINS=http://localhost:4200
GOOGLE_AUTH_ENABLED=false
GOOGLE_WEB_CLIENT_ID=
# === Google OAuth (server-side authorization code flow — Wiii-style redirect) ===
# Required only if GOOGLE_OAUTH_REDIRECT_FLOW_ENABLED=true.
# Authorized redirect URI must match exactly what's registered in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_FLOW_ENABLED=false
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8088/api/v3/auth/google/callback
GOOGLE_OAUTH_FRONTEND_CALLBACK=http://localhost:4200/auth/google/callback

# === Spring Profile ===
SPRING_PROFILES_ACTIVE=dev

# === Storage ===
# R2 stores master assets + offline downloadable files.
# Keep disabled in local dev unless you want to test object storage explicitly.
CLOUDFLARE_R2_ENABLED=false
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=lms-cdn
CLOUDFLARE_R2_PUBLIC_URL=

# === Cloudflare Stream (online playback only) ===
CLOUDFLARE_STREAM_ENABLED=false
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_KEY_ID=
# CLOUDFLARE_STREAM_PRIVATE_KEY=

# === AI / Wiii ===
# Keep Wiii disabled by default in local dev unless you explicitly need it.
AI_SERVICE_URL=https://wiii.holilihu.online
AI_SERVICE_API_KEY=
WIII_WEBHOOK_ENABLED=false
WIII_WEBHOOK_URL=
WIII_WEBHOOK_SECRET=
WIII_SERVICE_TOKEN=
WIII_TOKEN_EXCHANGE_URL=

# === Email (dev uses SMTP — optional) ===
# Gmail: enable 2FA → create App Password at https://myaccount.google.com/apppasswords
# Leave MAIL_USERNAME empty to skip email sending (logs warning instead)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# === VNPay (optional) ===
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=

# === SePay — QR Bank Transfer (optional) ===
# Register at https://my.sepay.vn, then set webhook URL:
#   https://your-domain/api/v3/payments/sepay/webhook
SEPAY_ENABLED=false
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=LMS MARITIME
SEPAY_WEBHOOK_API_KEY=
SEPAY_TEMPLATE_CODE=compact2

# === pgAdmin (dev only) ===
# Start with: docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile devtools up -d
PGADMIN_EMAIL=admin@lms.vn
PGADMIN_PASSWORD=admin123

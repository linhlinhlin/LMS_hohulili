# =============================================================================
# LMS Maritime - Production Environment
# Copy to .env.prod and fill real values. NEVER commit .env.prod to git!
# =============================================================================

# === Database ===
# Generate strong password: openssl rand -hex 16
POSTGRES_USER=lms
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=lms

# === JWT Security ===
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_256_BIT_SECRET
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# === Spring Profile ===
SPRING_PROFILES_ACTIVE=prod

# === App URLs ===
APP_BASE_URL=https://holilihu.online
APP_CORS_ORIGINS=https://holilihu.online

# === Storage ===
# Current production video stack: R2 private storage + Shaka Packager.
# Fill all values below before deploy if you want learner-facing video playback.
CLOUDFLARE_R2_ENABLED=true
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=lms-cdn
CLOUDFLARE_R2_VIDEO_BUCKET=lms-storage
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.holilihu.online
VIDEO_PLAYBACK_TOKEN_EXPIRY_SECONDS=14400
VIDEO_SEGMENT_PRESIGN_TTL_SECONDS=120
VIDEO_MEDIA_DOMAIN=
VIDEO_EDGE_AUTH_MODE=disabled
VIDEO_EDGE_HMAC_SECRET=
VIDEO_EDGE_TOKEN_EXPIRY_SECONDS=300
VIDEO_MANIFEST_CACHE_SECONDS=60
VIDEO_OBJECT_REDIRECT_CACHE_SECONDS=30
VIDEO_INGEST_ENABLED=true
VIDEO_PACKAGE_UPLOAD_CONCURRENCY=6
VIDEO_ADAPTIVE_SEGMENT_DURATION_SECONDS=6
VIDEO_FFMPEG_PRESET=veryfast
ENABLE_LOCAL_VIDEO_WORKER=true
BACKEND_CPU_LIMIT=1.5
BACKEND_CPU_RESERVATION=0.5
BACKEND_MEMORY_LIMIT=1536M
BACKEND_MEMORY_RESERVATION=768M
VIDEO_WORKER_CPU_LIMIT=1.5
VIDEO_WORKER_CPU_RESERVATION=0.5
VIDEO_WORKER_MEMORY_LIMIT=1536M
VIDEO_WORKER_MEMORY_RESERVATION=768M

# === AI Service (Legacy — unused if Wiii integration enabled) ===
AI_SERVICE_URL=https://wiii.holilihu.online
AI_SERVICE_API_KEY=

# === Wiii AI Integration (Sprint 220+226) ===
# Wiii is deployed at wiii.holilihu.online (separate GCP server)
WIII_WEBHOOK_URL=https://wiii.holilihu.online/api/v1/lms/webhook/maritime-lms
WIII_WEBHOOK_SECRET=CHANGE_ME_HMAC_SECRET
WIII_WEBHOOK_ENABLED=true
WIII_SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN
WIII_TOKEN_EXCHANGE_URL=https://wiii.holilihu.online/api/v1/auth/lms/token

# === Email (optional — leave empty to skip) ===
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RESEND_API_KEY=

# === VNPay (optional — leave empty to skip) ===
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=

# === Cloudflare Stream (legacy compatibility only — keep ENABLED=false for current video stack) ===
# Stream is the online playback layer (HLS/adaptive streaming).
# Offline MP4 profiles are managed separately by the LMS pipeline.
# 1. Go to Cloudflare Dashboard → Stream → Signing Keys → Create Key
# 2. CLOUDFLARE_ACCOUNT_ID: Dashboard → Account ID (top right)
# 3. CLOUDFLARE_STREAM_API_TOKEN: My Profile → API Tokens → Create (Stream:Edit)
# 4. CLOUDFLARE_STREAM_KEY_ID + CLOUDFLARE_STREAM_PRIVATE_KEY: from signing key
# Accepted private key formats:
#   - One-line PEM: -----BEGIN PRIVATE KEY-----MIIE...-----END PRIVATE KEY-----
#   - Base64 of the full PEM text (useful for secret managers / single-line env)
# PowerShell helper for base64-wrapping the PEM text:
#   [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content .\stream-private-key.pem -Raw)))
CLOUDFLARE_STREAM_ENABLED=false
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_KEY_ID=
# CLOUDFLARE_STREAM_PRIVATE_KEY=
# CLOUDFLARE_STREAM_TOKEN_EXPIRY=14400

# === R2 private video playback notes ===
# CLOUDFLARE_R2_VIDEO_BUCKET should stay private.
# Configure bucket CORS for your frontend origin with GET and HEAD.
# To move segment/init delivery off the backend hot path, set:
#   VIDEO_MEDIA_DOMAIN=https://media.holilihu.online
#   VIDEO_EDGE_AUTH_MODE=media_hmac_query
#   VIDEO_EDGE_HMAC_SECRET=<shared-secret-with-cloudflare>
# Keep disabled until Cloudflare media domain + edge auth is ready.
# Videos above the multipart threshold should upload via multipart direct-to-R2 instead of a single PUT.
# Set ENABLE_LOCAL_VIDEO_WORKER=false only after a separate worker VM is up via deploy-video-worker.sh.

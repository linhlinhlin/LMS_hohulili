# =============================================================================
# LMS Maritime - Production Environment
# Copy to .env.prod and fill real values. NEVER commit .env.prod to git!
# =============================================================================

# === Database ===
# Generate strong password: openssl rand -hex 16
POSTGRES_USER=lms
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=lms

# === JWT Security ===
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_256_BIT_SECRET
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# === Spring Profile ===
SPRING_PROFILES_ACTIVE=prod

# === App URLs ===
APP_BASE_URL=https://holilihu.online
APP_CORS_ORIGINS=https://holilihu.online

# === Storage ===
# Set R2_ENABLED=false for LocalStorage (default), true for Cloudflare R2
R2_ENABLED=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=lms-files
# R2_PUBLIC_URL=

# === AI Service ===
AI_SERVICE_URL=https://maritime-ai-chatbot.onrender.com
AI_SERVICE_API_KEY=

# === Email (optional — leave empty to skip) ===
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RESEND_API_KEY=

# === VNPay (optional — leave empty to skip) ===
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

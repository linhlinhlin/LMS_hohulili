### 5.2 Progress Calculation Service

```java
/**
 * Domain Service: Progress Calculation
 * Handles complex progress calculation logic
 */
@Service
@Transactional(readOnly = true)
public class ProgressCalculationDomainService {
    
    /**
     * Calculates overall course progress for a student
     */
    public ProgressPercentage calculateCourseProgress(Student student, Course course) {
        LearningProgress learningProgress = student.getLearningProgress(course.getId())
                .orElseThrow(() -> new DomainException("Student not enrolled in course"));
        
        Set<LessonProgress> completedLessons = learningProgress.getLessonProgress().stream()
                .filter(LessonProgress::isCompleted)
                .collect(Collectors.toSet());
        
        Set<Lesson> totalLessons = course.getAllLessons();
        
        if (totalLessons.isEmpty()) {
            return ProgressPercentage.hundred(); // No lessons means 100% complete
        }
        
        BigDecimal progress = BigDecimal.valueOf(completedLessons.size())
                .divide(BigDecimal.valueOf(totalLessons.size()), 4, RoundingMode.HALF_UP)
                .multiply(BigDecimal.valueOf(100));
        
        return ProgressPercentage.of(progress);
    }
    
    /**
     * Finds next lesson to continue learning
     */
    public Lesson findNextLessonToContinue(Student student, Course course) {
        // Get all lessons in course order
        List<Lesson> orderedLessons = course.getOrderedLessons();
        
        // Get student's completed lessons
        Set<UUID> completedLessonIds = student.getCompletedLessonIds(course.getId());
        
        // Find first uncompleted lesson
        return orderedLessons.stream()
                .filter(lesson -> !completedLessonIds.contains(lesson.getId()))
                .findFirst()
                .orElse(orderedLessons.get(0)); // Return first lesson if all completed
    }
    
    /**
     * Calculates estimated time to completion
     */
    public Duration estimateTimeToCompletion(Student student, Course course) {
        ProgressPercentage currentProgress = calculateCourseProgress(student, course);
        
        if (currentProgress.isCompleted()) {
            return Duration.of(0);
        }
        
        // Get remaining uncompleted lessons
        Set<Lesson> remainingLessons = course.getAllLessons().stream()
                .filter(lesson -> !student.isLessonCompleted(lesson.getId()))
                .collect(Collectors.toSet());
        
        // Calculate total remaining duration
        Duration totalRemainingDuration = remainingLessons.stream()
                .map(Lesson::getEstimatedDuration)
                .reduce(Duration.of(0), Duration::add);
        
        return totalRemainingDuration;
    }
}

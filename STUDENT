### 10.2 Complete Lesson Use Case

```java
/**
 * Application Service: Complete Lesson Use Case
 * Handles lesson completion with all business rules
 */
@Service
@Transactional
public class CompleteLessonUseCase {
    
    private final StudentRepository studentRepository;
    private final CourseRepository courseRepository;
    private final LessonRepository lessonRepository;
    private final LearningProgressRepository progressRepository;
    private final ProgressCalculationDomainService progressService;
    private final DomainEventPublisher eventPublisher;
    
    public LessonProgressDto execute(UUID studentId, UUID lessonId, CompleteLessonRequest request) {
        // Load aggregates
        Student student = studentRepository.findById(studentId)
                .orElseThrow(() -> new DomainException("Student not found"));
        
        Lesson lesson = lessonRepository.findById(lessonId)
                .orElseThrow(() -> new DomainException("Lesson not found"));
        
        Course course = lesson.getSection().getCourse();
        
        // Validate business rules
        ProgressBusinessRules.validateEnrollment(student, course);
        ProgressBusinessRules.validateLessonAccessibility(student, lesson);
        
        // Get or create learning progress
        LearningProgress learningProgress = progressRepository.findByStudentAndCourse(studentId, course.getId())
                .orElseGet(() -> createLearningProgress(student, course));
        
        // Update lesson progress
        LessonProgress lessonProgress = learningProgress.getLessonProgress(lessonId)
                .orElseGet(() -> createLessonProgress(student, lesson, learningProgress));
        
        lessonProgress.complete();
        lessonProgress.setScore(request.getScore());
        lessonProgress.setTimeSpentMinutes(request.getTimeSpentMinutes());
        
        // Recalculate overall progress
        ProgressPercentage newProgress = progressService.calculateCourseProgress(student, course);
        learningProgress.updateProgress(newProgress);
        
        // Save changes
        progressRepository.save(learningProgress);
        
        // Check for course completion
        if (learningProgress.isCompleted()) {
            course.markCompletion(student);
            courseRepository.save(course);
            
            // Publish completion event
            eventPublisher.publish(new CourseCompletedEvent(
                studentId, course.getId(), Instant.now()
            ));
        }
        
        // Publish lesson completion event
        eventPublisher.publish(new LessonCompletedEvent(
            studentId, lessonId, Instant.now()
        ));
        
        return LessonProgressDto.from(lessonProgress);
    }
    
    private LearningProgress createLearningProgress(Student student, Course course) {
        return LearningProgress.builder()
                .student(student)
                .course(course)
                .status(ProgressStatus.IN_PROGRESS)
                .startedAt(Instant.now())
                .build();
    }
    
    private LessonProgress createLessonProgress(Student student, Lesson lesson, LearningProgress progress) {
        return LessonProgress.builder()
                .student(student)
                .lesson(lesson)
                .progress(progress)
                .status(LessonStatus.IN_PROGRESS)
                .build();
    }
}

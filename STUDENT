/**
 * Application Service: Enroll Student Use Case
 * Orchestrates the enrollment process across multiple aggregates
 */
@Service
@Transactional
public class EnrollStudentUseCase {
    
    private final StudentRepository studentRepository;
    private final CourseRepository courseRepository;
    private final EnrollmentRepository enrollmentRepository;
    private final StudentEnrollmentDomainService enrollmentService;
    private final DomainEventPublisher eventPublisher;
    
    public EnrollmentDto execute(UUID studentId, UUID courseId) {
        // Load aggregates
        Student student = studentRepository.findById(studentId)
                .orElseThrow(() -> new DomainException("Student not found"));
        
        Course course = courseRepository.findById(courseId)
                .orElseThrow(() -> new DomainException("Course not found"));
        
        // Use domain service for business logic
        Enrollment enrollment = enrollmentService.enrollStudent(student, course);
        
        // Persist changes
        studentRepository.save(student);
        courseRepository.save(course);
        Enrollment savedEnrollment = enrollmentRepository.save(enrollment);
        
        // Publish domain event
        eventPublisher.publish(new StudentEnrolledEvent(
            studentId, courseId, Instant.now()
        ));
        
        // Return DTO
        return EnrollmentDto.from(savedEnrollment);
    }
}

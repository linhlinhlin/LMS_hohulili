### 7.2 Progress Business Rules

```java
/**
 * Business Rules: Learning Progress
 * Defines all progress-related business constraints
 */
public class ProgressBusinessRules {
    
    /**
     * Rule: Student must be enrolled to track progress
     */
    public static void validateEnrollment(Student student, Course course) {
        if (!student.isEnrolledIn(course.getId())) {
            throw new BusinessRuleViolation("Student must be enrolled in course to track progress");
        }
    }
    
    /**
     * Rule: Lesson completion requires lesson to exist and be accessible
     */
    public static void validateLessonAccessibility(Student student, Lesson lesson) {
        Course course = lesson.getSection().getCourse();
        
        if (!student.hasAccessTo(course)) {
            throw new BusinessRuleViolation("Student does not have access to this lesson");
        }
    }
    
    /**
     * Rule: Progress cannot be negative
     */
    public static void validateProgressPercentage(ProgressPercentage progress) {
        if (progress.getValue().compareTo(BigDecimal.ZERO) < 0) {
            throw new BusinessRuleViolation("Progress percentage cannot be negative");
        }
    }
    
    /**
     * Rule: Completion time cannot be before start time
     */
    public static void validateCompletionTime(Instant startedAt, Instant completedAt) {
        if (completedAt.isBefore(startedAt)) {
            throw new BusinessRuleViolation("Completion time cannot be before start time");
        }
    }
    
    /**
     * Rule: Course is complete when all required lessons are finished
     */
    public static boolean isCourseComplete(LearningProgress progress) {
        Course course = progress.getCourse();
        Set<LessonProgress> lessonProgress = progress.getLessonProgress();
        
        Set<Lesson> requiredLessons = course.getRequiredLessons();
        Set<Lesson> completedLessons = lessonProgress.stream()
                .filter(LessonProgress::isCompleted)
                .map(LessonProgress::getLesson)
                .collect(Collectors.toSet());
        
        return requiredLessons.equals(completedLessons);
    }
}

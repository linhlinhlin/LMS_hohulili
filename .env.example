# =============================================================================
# LMS Maritime - Environment Configuration
# Copy to .env.dev or .env.prod and fill values
# NEVER commit .env.dev or .env.prod to git!
# =============================================================================

# === Database ===
POSTGRES_USER=lms
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=lms

# === JWT Security ===
# Generate: openssl rand -hex 32
JWT_SECRET=your-256-bit-secret-here-replace-this
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# === Cloudflare R2 Storage ===
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=lms-tracnghiemj-image
R2_PUBLIC_URL=

# === AI Service ===
AI_SERVICE_URL=https://maritime-ai-chatbot.onrender.com
AI_SERVICE_API_KEY=

# === Spring Profile ===
SPRING_PROFILES_ACTIVE=dev

# === pgAdmin (dev only) ===
PGADMIN_EMAIL=admin@lms.vn
PGADMIN_PASSWORD=admin123

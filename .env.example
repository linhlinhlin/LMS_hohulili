# =============================================================================
# Maritime LMS - Legacy Shared Example
# Prefer `.env.dev.example` for local development and `.env.prod.example` for production.
# This file remains as a compatibility alias for the dev example.
# Root compose is the single supported local runtime topology.
# =============================================================================

# === Database ===
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_DB=lms

# === JWT Security ===
# Dev-only Base64 key placeholder. Replace if your local setup needs a custom value.
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1zZWNyZXQta2V5LWZvci1sbXMtYXBwbGljYXRpb24tbWluaW11bS0yNTYtYml0cw==
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# === Cloudflare R2 Storage ===
# Set R2_ENABLED=false to use LocalStorageService (default for dev)
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=lms-files
R2_PUBLIC_URL=

# === AI / Wiii ===
AI_SERVICE_URL=https://wiii.holilihu.online
AI_SERVICE_API_KEY=
WIII_WEBHOOK_ENABLED=false
WIII_WEBHOOK_URL=
WIII_WEBHOOK_SECRET=
WIII_SERVICE_TOKEN=
WIII_TOKEN_EXCHANGE_URL=

# === App URLs ===
APP_BASE_URL=http://localhost:4200
APP_CORS_ORIGINS=http://localhost:4200

# === Email (optional) ===
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RESEND_API_KEY=

# === VNPay (optional) ===
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# === Spring Profile ===
SPRING_PROFILES_ACTIVE=dev

# === pgAdmin (dev only) ===
# Start with: docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile devtools up -d
PGADMIN_EMAIL=admin@lms.vn
PGADMIN_PASSWORD=admin123

# =============================================================================
# LMS Maritime - Environment Configuration
# Copy to .env.dev (development) or .env.prod (production) and fill values
# NEVER commit .env.dev or .env.prod to git!
# =============================================================================

# === Database ===
POSTGRES_USER=lms
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=lms

# === JWT Security ===
# Generate: openssl rand -hex 32
JWT_SECRET=your-256-bit-secret-here-replace-this
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# === Cloudflare R2 Storage ===
# Set R2_ENABLED=false to use LocalStorageService (default for dev)
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=lms-tracnghiemj-image
R2_PUBLIC_URL=

# === AI Service ===
AI_SERVICE_URL=https://maritime-ai-chatbot.onrender.com
AI_SERVICE_API_KEY=

# === App URLs ===
APP_BASE_URL=http://localhost:4200
APP_CORS_ORIGINS=http://localhost:4200

# === Email (optional) ===
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RESEND_API_KEY=

# === VNPay (optional) ===
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# === Spring Profile ===
SPRING_PROFILES_ACTIVE=dev

# === pgAdmin (dev only) ===
PGADMIN_EMAIL=admin@lms.vn
PGADMIN_PASSWORD=admin123

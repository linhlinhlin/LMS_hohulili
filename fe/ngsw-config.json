{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/main-*.js",
          "/polyfills-*.js"
        ]
      }
    },
    {
      "name": "lazy-chunks",
      "installMode": "prefetch",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/chunk-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "course-catalog",
      "urls": [
        "/api/v3/courses",
        "/api/v3/courses?*",
        "/api/v3/categories",
        "/api/v3/categories/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "7d",
        "strategy": "freshness",
        "timeout": "5s"
      }
    },
    {
      "name": "course-content",
      "urls": [
        "/api/v3/courses/*/chapters",
        "/api/v3/courses/*/chapters/**",
        "/api/v3/courses/*/lessons/**"
      ],
      "cacheConfig": {
        "maxSize": 500,
        "maxAge": "30d",
        "strategy": "freshness",
        "timeout": "8s"
      }
    },
    {
      "name": "images",
      "urls": [
        "/api/v3/files/view/**"
      ],
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "30d",
        "strategy": "performance"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/__**",
    "!/api/**",
    "!/actuator/**"
  ],
  "navigationRequestStrategy": "performance"
}

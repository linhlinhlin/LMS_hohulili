        <mxCell id="t_gal" value="&lt;b&gt;grading_audit_log&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;🔗 submission_id, grader_id&lt;br&gt;old_grade → new_grade&lt;br&gt;action, reason&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="z6">
          <mxGeometry x="30" y="460" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t_gam" value="&lt;b&gt;learning_events&lt;/b&gt; · &lt;b&gt;learning_streaks&lt;/b&gt;&lt;br&gt;&lt;b&gt;achievements&lt;/b&gt; · &lt;b&gt;student_achievements&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;Gamification: XP, streak, badges&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="z6">
          <mxGeometry x="320" y="440" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="t_ai" value="&lt;b&gt;ai_insights&lt;/b&gt; · &lt;b&gt;ai_alerts&lt;/b&gt; · &lt;b&gt;chat_sessions / chat_messages&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;Wiii AI: phát hiện HV nguy cơ, chat hỗ trợ&lt;br&gt;context_type: GENERAL / COURSE / LESSON&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="z6">
          <mxGeometry x="30" y="600" width="550" height="120" as="geometry" />
        </mxCell>

        <!-- ==================== ZONE 7 — CERTIFICATE ==================== -->
        <mxCell id="z7" value="7. CHỨNG CHỈ" style="swimlane;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;startSize=32;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1260" y="870" width="520" height="800" as="geometry" />
        </mxCell>
        <mxCell id="t_cond" value="&lt;b&gt;ĐIỀU KIỆN CẤP&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;enrollments.completion_percent = 100&lt;br&gt;AND tất cả lessons required đã&lt;br&gt;&amp;nbsp;&amp;nbsp;COMPLETED&lt;br&gt;AND tất cả quizzes đã đạt&lt;br&gt;&amp;nbsp;&amp;nbsp;passing_score&lt;br&gt;AND tất cả assignments đã GRADED&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=top;fontStyle=1;" vertex="1" parent="z7">
          <mxGeometry x="30" y="50" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="t_cert" value="&lt;b&gt;certificates&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;🔗 enrollment_id (UNIQUE — 1 cert/enrollment)&lt;br&gt;🔗 student_id, course_id&lt;br&gt;verification_token (UUID, public)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ xác minh QR public&lt;br&gt;issued_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="z7">
          <mxGeometry x="30" y="270" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t_review" value="&lt;b&gt;course_reviews&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;🔗 course_id, student_id&lt;br&gt;UNIQUE (course_id, student_id)&lt;br&gt;rating: 1..5&lt;br&gt;comment&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="z7">
          <mxGeometry x="30" y="470" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- ==================== ZONE 8 — PAYOUT ==================== -->
        <mxCell id="z8" value="8. GIẢNG VIÊN RÚT TIỀN (PAYOUT)" style="swimlane;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;startSize=32;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1800" y="870" width="680" height="800" as="geometry" />
        </mxCell>
        <mxCell id="t_bank" value="&lt;b&gt;teacher_bank_accounts&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;🔗 teacher_id → users&lt;br&gt;bank_code (MBBank / VCB / TCB …)&lt;br&gt;account_number, account_name&lt;br&gt;is_default (partial UNIQUE)&lt;br&gt;verified&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="z8">
          <mxGeometry x="30" y="50" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t_avail" value="&lt;b&gt;TÍNH SỐ DƯ KHẢ DỤNG&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;SUM(revenue_splits.teacher_amount&lt;br&gt;&amp;nbsp;&amp;nbsp;WHERE teacher_id = ?)&lt;br&gt;−&lt;br&gt;SUM(payout_requests.amount&lt;br&gt;&amp;nbsp;&amp;nbsp;WHERE status IN (APPROVED,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;COMPLETED, PENDING))&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=top;fontStyle=1;" vertex="1" parent="z8">
          <mxGeometry x="350" y="50" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t_po" value="&lt;b&gt;payout_requests&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;🔑 id (PK)&lt;br&gt;🔗 teacher_id → users&lt;br&gt;🔗 bank_account_id → teacher_bank_accounts&lt;br&gt;amount (> 0)&lt;br&gt;status: PENDING → APPROVED /&lt;br&gt;&amp;nbsp;&amp;nbsp;REJECTED / COMPLETED /&lt;br&gt;&amp;nbsp;&amp;nbsp;CANCELLED&lt;br&gt;teacher_note, admin_note&lt;br&gt;🔗 processed_by → users (admin)&lt;br&gt;requested_at, processed_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="z8">
          <mxGeometry x="30" y="250" width="610" height="270" as="geometry" />
        </mxCell>
        <mxCell id="t_invariant" value="&lt;b&gt;INVARIANT QUAN TRỌNG&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;① revenue_splits APPEND-ONLY — không UPDATE/DELETE&lt;br&gt;② revenue_splits.payment_id UNIQUE (1-1 với payment_transactions)&lt;br&gt;③ enrollments UNIQUE (student_id, class_id)&lt;br&gt;④ assignment_submissions UNIQUE (assignment_id, student_id) — upsert&lt;br&gt;⑤ certificates UNIQUE (enrollment_id)&lt;br&gt;⑥ course_versions.snapshot_content BẤT BIẾN sau publish&lt;br&gt;⑦ class_teachers chỉ 1 PRIMARY / class (partial unique)&lt;br&gt;⑧ teacher_bank_accounts chỉ 1 is_default=TRUE / teacher&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=top;fontStyle=1;" vertex="1" parent="z8">
          <mxGeometry x="30" y="550" width="610" height="200" as="geometry" />
        </mxCell>

        <!-- ==================== FK / FLOW ARROWS (inter-zone) ==================== -->
        <!-- Step 1 → Step 2: teacher tạo course -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;strokeWidth=3;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_users" target="t_courses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_lbl" value="① teacher_id" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Step 2 → Step 3: submit for review -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;strokeWidth=3;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_courses" target="t_status_sm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2_lbl" value="② submit review" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e2">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Step 3 → Step 4: publish → open class -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;strokeWidth=3;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_cv" target="t_lc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_lbl" value="③ course_version_id" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e3">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Step 4 → Step 5: class → payment -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=3;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_lc" target="t_pay">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1770" y="200" />
              <mxPoint x="1770" y="830" />
              <mxPoint x="640" y="830" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4_lbl" value="④ HV ghi danh + thanh toán" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e4">
          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- payment → revenue_splits (inside zone 5) -->
        <mxCell id="e4b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=3;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_pay" target="t_rs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4b_lbl" value="COMPLETED → split" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e4b">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- payment → enrollments -->
        <mxCell id="e4c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;strokeWidth=2;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_pay" target="t_enroll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4c_lbl" value="tạo enrollment" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=2;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e4c">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Step 5 → Step 6: enrollment → learning -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;strokeWidth=3;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_enroll" target="t_slp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5_lbl" value="⑤ enrollment_id" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e5">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Step 6 → Step 7: completion → certificate -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;strokeWidth=3;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_slp" target="t_cert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6_lbl" value="⑥ 100% → cấp chứng chỉ" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e6">
          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Step 5 (revenue_splits) → Step 8 (payout) -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=3;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_rs" target="t_avail">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1500" y="400" />
              <mxPoint x="1500" y="980" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7_lbl" value="⑦ SUM teacher_amount" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e7">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- bank → payout -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;strokeWidth=2;endArrow=classic;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_bank" target="t_po">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8_lbl" value="⑧ bank_account_id" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" connectable="0" parent="e8">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- avail → payout -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;strokeWidth=2;endArrow=classic;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_avail" target="t_po">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== LEGEND ==================== -->
        <mxCell id="legend" value="&lt;b&gt;CHÚ GIẢI&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div align=&quot;left&quot;&gt;🔑 Primary Key (PK)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;🔗 Foreign Key (FK)&lt;br&gt;━━━ Luồng nghiệp vụ chính (① → ⑧)&lt;br&gt;╌╌╌ Quan hệ phụ / trigger&lt;br&gt;&lt;span style=&quot;background:#fff8e1;padding:2px 6px;&quot;&gt;Vùng vàng&lt;/span&gt; = Invariant / state machine&lt;br&gt;&lt;span style=&quot;background:#fff4e6;padding:2px 6px;&quot;&gt;Vùng cam&lt;/span&gt; = Append-only ledger (không sửa)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="1685" width="600" height="10" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

        <!-- ============ LEGEND: Crow's Foot Notation ============ -->
        <mxCell id="legend" value="&lt;b style=&quot;font-size:13px;&quot;&gt;CROW&amp;#39;S FOOT (IE) NOTATION&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;table cellpadding=&quot;3&quot; style=&quot;font-family:Arial;font-size:11px;text-align:left;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Consolas,monospace;font-size:14px;width:60px;&quot;&gt;━┃━&lt;/td&gt;&lt;td&gt;&lt;b&gt;Exactly one (1..1)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Consolas,monospace;font-size:14px;&quot;&gt;━┃&amp;lt;&lt;/td&gt;&lt;td&gt;One to many (1..N)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Consolas,monospace;font-size:14px;&quot;&gt;━○┃&lt;/td&gt;&lt;td&gt;Zero or one (0..1)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Consolas,monospace;font-size:14px;&quot;&gt;━○&amp;lt;&lt;/td&gt;&lt;td&gt;Zero or many (0..N)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot;&gt;&lt;hr size=&quot;1&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#b85450;font-weight:bold;&quot;&gt;PK&lt;/td&gt;&lt;td&gt;Primary Key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#d79b00;font-weight:bold;&quot;&gt;FK&lt;/td&gt;&lt;td&gt;Foreign Key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#9673a6;font-weight:bold;&quot;&gt;U&lt;/td&gt;&lt;td&gt;UNIQUE constraint&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;NN&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot;&gt;&lt;hr size=&quot;1&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot;&gt;&lt;b&gt;Line style:&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;───&lt;/td&gt;&lt;td&gt;Identifying (FK NOT NULL)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;╌╌╌&lt;/td&gt;&lt;td&gt;Non-identifying (FK nullable)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot;&gt;&lt;hr size=&quot;1&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot;&gt;&lt;b&gt;Module colors:&lt;/b&gt;&
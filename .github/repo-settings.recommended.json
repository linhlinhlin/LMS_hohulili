{
  "repository": "linhlinhlin/LMS_hohulili",
  "description": "Production-first maritime LMS with Angular, Spring Boot, PWA offline learning, adaptive video, and role-based operations.",
  "homepage": "https://holilihu.online",
  "topics": [
    "lms",
    "maritime",
    "angular",
    "spring-boot",
    "postgresql",
    "pwa",
